{
    "name": "xil",
    "image": "xil:latest",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-docker",
                "llvm-vs-code-extensions.vscode-clangd",
                "bitwisecook.tcl",
                "shardulm94.trailing-spaces",
                "yocto-project.yocto-bitbake",
                "mshr-h.VerilogHDL",
                "plorefice.devicetree",
                "chipsalliance.verible",
                "streetsidesoftware.code-spell-checker",
                "twxs.cmake"
            ]
        }
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind,consistency=default",
    "workspaceFolder": "/app"
}