{
    "[systemverilog]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    },
    "[tcl]": {
        "editor.formatOnSave": false
    },
    "editor.formatOnSave": true,
    "search.exclude": {
        "submodules": true
    },
    "systemverilog.includeIndexing": [
        "**/rtl/**/*.{sv, svh, v, vh}",
        "**/sim/**/*.{sv, svh, v, vh}"
    ],
    "systemverilog.antlrVerification": true,
    "systemverilog.excludeIndexing": "**/rtl/top.sv",
    "systemverilog.excludeCompiling": "**/rtl/top.sv",
    "systemverilog.formatCommand": "verible-verilog-format",
    "systemverilog.compilerType": "Verible",
    "systemverilog.launchConfigurationVerible": "verible-verilog-lint --ruleset all",
    "systemverilog.compileOnOpen": false,
    "systemverilog.compileOnSave": false,
    "systemverilog.verifyOnOpen": true
}